# Projeto Nimbus — configuracao
# Copie para .env: cp .env.example .env

DEFAULT_SCENARIO=baseline
DEFAULT_FORMAT=all

# SLM — modelo baixado automaticamente no primeiro boot
# CPU leve: phi3.5 | CPU qualidade: phi4 (padrao) | GPU: qwen2.5-coder:7b
OLLAMA_MODEL=phi4
SKIP_SLM=false
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# GPU AMD/ROCm (descomente a secao no docker-compose.yml):
# AMD_GFX_VERSION=11.0.0

# Credencial do object storage: obrigatoria, sem default no codigo nem no compose.
# Gere uma local antes de subir (ex.: openssl rand -hex 16) e nao versione o .env.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Object storage gerenciado (S3, R2, GCS/S3, Azure via endpoint: S3): endpoint com
# TLS, regiao na assinatura e prefixo do bucket  - nome de bucket em nuvem e global.
# MINIO_ENDPOINT=s3.us-east-1.amazonaws.com
# MINIO_SECURE=true
# MINIO_REGION=us-east-1
# BUCKET_PREFIX=nimbus-datamasters
# MINIO_CREATE_BUCKETS=false
# Data de referencia da carga (YYYY-MM-DD). Vazia = derivada do run_id.
# Reprocessar a mesma dat_ref sobrescreve a particao em vez de duplicar.
DAT_REF=
STRICT_TYPING=true
QUALITY_GATE=true
#true = manifesto em DRAFT nao publica a Silver (gate de governanca do Data Steward)
REQUIRE_VALIDATED_MANIFEST=false

# Databricks (opcional — deixe vazio para ignorar)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# SQL Editor > nome do warehouse > copy ID
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_AUTO_UPLOAD=True
DATABRICKS_VOLUME=landing
DATABRICKS_CATALOG=nimbus
DATABRICKS_SILVER_SCHEMA=silver
DATABRICKS_BRONZE_SCHEMA=bronze
DATABRICKS_BRONZE_VOLUME=landing
DATABRICKS_BRONZE_UPLOAD=True
# Rejeito carrega o registro que falhou, com os mesmos dados pessoais do aprovado.
# Ligue so quando o destino da quarentena tiver o controle de acesso adequado.
DATABRICKS_QUARANTINE_UPLOAD=False
# Mascara as colunas marcadas LGPD_SENSITIVE no Manifest antes de gravar o rejeito.
QUARANTINE_MASK_PII=True
# Carga reprovada no gate sai da Silver e fica na quarentena, auditavel.
QUARANTINE_BLOCKED_SILVER=True