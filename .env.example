# Projeto Nimbus — configuracao
# Copie para .env e ajuste antes de rodar: cp .env.example .env

# Pipeline
DEFAULT_SCENARIO=baseline
DEFAULT_FORMAT=all

# SLM — modelo baixado automaticamente no primeiro boot
# CPU leve: phi3.5 | CPU qualidade: phi4 | GPU: qwen2.5-coder:7b
OLLAMA_MODEL=phi3.5
SKIP_SLM=false
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# GPU AMD/ROCm (descomente a secao no docker-compose.yml e ajuste):
# AMD_GFX_VERSION=11.0.0

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Databricks (opcional — deixe vazio para ignorar)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_AUTO_UPLOAD=false
DATABRICKS_DBFS_BASE=/nimbus/silver
DATABRICKS_CATALOG=hive_metastore
DATABRICKS_SCHEMA=nimbus
